@page "/"
@using System.Text.Json
@inject HttpClient Http

<PageTitle>ТОиР-Проф — Blazor Dashboard</PageTitle>

<div class="container-fluid p-4" style="background-color: #0f172a; min-height: 100vh; color: #f8fafc;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #38bdf8;">ТОиР-Проф [Blazor WebAssembly]</h2>
            <p class="text-secondary mb-0">Единая экосистема C# Fullstack для управления ТО и ремонтами</p>
        </div>
        <button class="btn btn-primary" @onclick="LoadDashboard">🔄 Обновить данные</button>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-info" role="status"></div>
            <p class="mt-3 text-secondary">Загрузка данных через REST API...</p>
        </div>
    }
    else if (kpi != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-2">
                <div class="card p-3" style="background-color: #1e293b; border: 1px solid #334155;">
                    <div class="text-secondary small">ПАРК ОБОРУДОВАНИЯ</div>
                    <div class="fs-2 fw-bold text-light">@kpi.TotalEquipment <span class="fs-6 text-secondary">ед.</span></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card p-3" style="background-color: #1e293b; border: 1px solid #334155;">
                    <div class="text-secondary small">АКТИВНЫЕ ЗАЯВКИ</div>
                    <div class="fs-2 fw-bold text-warning">@kpi.ActiveWorkOrders <span class="fs-6 text-secondary">в работе</span></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card p-3" style="background-color: #1e293b; border: 1px solid #334155;">
                    <div class="text-secondary small">ВЫПОЛНЕННЫЕ РЕМОНТЫ</div>
                    <div class="fs-2 fw-bold text-success">@kpi.CompletedWorkOrders <span class="fs-6 text-secondary">заявок</span></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card p-3" style="background-color: #1e293b; border: 1px solid #334155;">
                    <div class="text-secondary small">СУММАРНЫЙ ПРОСТОЙ</div>
                    <div class="fs-2 fw-bold text-danger">@kpi.TotalDowntimeHours <span class="fs-6 text-secondary">ч.</span></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card p-3" style="background-color: #1e293b; border: 1px solid #334155;">
                    <div class="text-secondary small">СРЕДНЕЕ ВРЕМЯ (MTTR)</div>
                    <div class="fs-2 fw-bold text-info">@kpi.AverageRepairHours <span class="fs-6 text-secondary">ч.</span></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card p-3" style="background-color: #1e293b; border: 1px solid #334155;">
                    <div class="text-secondary small">ГРАФИК ТО (ППР)</div>
                    <div class="fs-2 fw-bold text-success">@kpi.MaintenanceComplianceRate%</div>
                </div>
            </div>
        </div>

        <div class="card p-4" style="background-color: #1e293b; border: 1px solid #334155;">
            <h5 class="fw-bold mb-3 text-light">Последние зарегистрированные заявки ТОиР</h5>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" style="background-color: transparent;">
                    <thead>
                        <tr class="text-secondary">
                            <th>№ Заявки</th>
                            <th>Оборудование</th>
                            <th>Цех</th>
                            <th>Мастер</th>
                            <th>Статус</th>
                            <th>Простой</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in kpi.RecentWorkOrders)
                        {
                            <tr>
                                <td class="fw-bold text-info">@order.OrderNumber</td>
                                <td>@order.EquipmentName (@order.InventoryNumber)</td>
                                <td>@order.WorkshopName</td>
                                <td>@order.MasterName</td>
                                <td><span class="badge bg-secondary">@order.StatusName</span></td>
                                <td>@order.DowntimeHours ч.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private DashboardKpiModel? kpi;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            var options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
            kpi = await Http.GetFromJsonAsync<DashboardKpiModel>("http://localhost:5000/api/analytics/dashboard", options);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Blazor load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    public class DashboardKpiModel
    {
        public int TotalEquipment { get; set; }
        public int ActiveWorkOrders { get; set; }
        public int CompletedWorkOrders { get; set; }
        public decimal TotalDowntimeHours { get; set; }
        public decimal AverageRepairHours { get; set; }
        public decimal MaintenanceComplianceRate { get; set; }
        public List<WorkOrderItemModel> RecentWorkOrders { get; set; } = new();
    }

    public class WorkOrderItemModel
    {
        public string OrderNumber { get; set; } = "";
        public string EquipmentName { get; set; } = "";
        public string InventoryNumber { get; set; } = "";
        public string WorkshopName { get; set; } = "";
        public string MasterName { get; set; } = "";
        public string StatusName { get; set; } = "";
        public decimal DowntimeHours { get; set; }
    }
}
