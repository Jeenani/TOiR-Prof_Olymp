<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Desktop.Views.SchedulesView">
  <Grid>
    <Grid RowDefinitions="Auto,*" Margin="20">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="График планово-предупредительного ТО (ППР)" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Интерактивный календарь, индикация просрочек (красный) и ближайших 3 дней (жёлтый)" FontSize="12" Foreground="#64748B" />
        </StackPanel>
        <Button Grid.Column="1" Content="Сбросить дату" Classes="secondary" Margin="0,0,8,0" Click="OnClearDateClick" />
        <Button Grid.Column="2" Content="+ Запланировать ТО" Classes="primary" Click="OnAddScheduleClick" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="360,*">
        <Border Grid.Column="0" Classes="card" Margin="0,0,14,0">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Grid.Column="0" Content="◀" Classes="secondary" Click="OnPrevMonth" />
              <TextBlock x:Name="MonthTitle" Grid.Column="1" Text="Ноябрь 2026" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="▶" Classes="secondary" Click="OnNextMonth" />
            </Grid>
            <UniformGrid Columns="7">
              <TextBlock Text="Пн" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="Вт" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="Ср" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="Чт" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="Пт" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="Сб" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#DC2626" />
              <TextBlock Text="Вс" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#DC2626" />
            </UniformGrid>
            <UniformGrid x:Name="CalendarGrid" Columns="7" Rows="6" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="12" Height="12" CornerRadius="3" Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1" />
                <TextBlock Text="Просрочено" FontSize="11" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="12" Height="12" CornerRadius="3" Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" />
                <TextBlock Text="&lt;= 3 дн." FontSize="11" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="12" Height="12" CornerRadius="3" Background="#DBEAFE" BorderBrush="#2563EB" BorderThickness="1" />
                <TextBlock Text="План" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="10">
          <Grid RowDefinitions="Auto,*">
            <TextBlock x:Name="TableHeaderText" Grid.Row="0" Text="Все записи за месяц" FontWeight="SemiBold" Margin="4,0,0,8" />
            <DataGrid x:Name="SchedulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" LoadingRow="OnScheduleLoadingRow">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding PlannedDate}" Width="100" />
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}" Width="85" />
                <DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentName}" Width="*" />
                <DataGridTextColumn Header="Вид ТО" Binding="{Binding TypeCode}" Width="75" />
                <DataGridTextColumn Header="Бригада" Binding="{Binding TeamName}" Width="140" />
                <DataGridTextColumn Header="Состояние" Binding="{Binding StatusBadgeText}" Width="125" />
                <DataGridTemplateColumn Header="Заявка" Width="135">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Создать заявку" Padding="8,4" FontSize="11" Click="OnGenerateOrderClick" Tag="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="AddModal" Background="#80000000" IsVisible="False">
      <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="card"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Новое плановое ТО" FontSize="18" FontWeight="Bold" />
          <StackPanel Spacing="4">
            <TextBlock Text="Оборудование *" FontSize="12" FontWeight="SemiBold" />
            <ComboBox x:Name="AddEqBox" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Вид ТО *" FontSize="12" FontWeight="SemiBold" />
            <ComboBox x:Name="AddTypeBox" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Бригада" FontSize="12" FontWeight="SemiBold" />
            <ComboBox x:Name="AddTeamBox" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Плановая дата (ГГГГ-ММ-ДД) *" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="AddDateBox" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
            <Button Content="Отмена" Classes="secondary" Click="OnCloseAddModal" />
            <Button Content="Сохранить" Classes="primary" Click="OnSaveScheduleClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
