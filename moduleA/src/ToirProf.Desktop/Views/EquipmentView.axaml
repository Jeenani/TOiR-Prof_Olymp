<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Desktop.Views.EquipmentView">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Реестр промышленного оборудования" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Поиск, фильтрация, история статусов, ТО и контроль удаления" FontSize="12" Foreground="#64748B" />
        </StackPanel>
        <Button Grid.Column="1" Content="+ Добавить оборудование" Classes="primary" Click="OnAddClick" />
      </Grid>

      <Border Grid.Row="1" Classes="card" Padding="12" Margin="0,0,0,12">
        <WrapPanel Orientation="Horizontal">
          <TextBox x:Name="SearchBox" Width="220" Margin="0,0,10,6" Watermark="Поиск (инв. номер, название)..." />
          <ComboBox x:Name="WorkshopFilter" Width="190" Margin="0,0,10,6" SelectionChanged="OnFilterChanged" />
          <ComboBox x:Name="StatusFilter" Width="170" Margin="0,0,10,6" SelectionChanged="OnFilterChanged" />
          <TextBox x:Name="ModelFilter" Width="150" Margin="0,0,10,6" Watermark="Модель..." />
          <Button Content="Найти" Classes="primary" Margin="0,0,8,6" Click="OnSearchClick" />
          <Button Content="Сброс" Classes="secondary" Margin="0,0,8,6" Click="OnResetClick" />
        </WrapPanel>
      </Border>

      <Border Grid.Row="2" Classes="card" Padding="8">
        <DataGrid x:Name="EquipmentGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" Sorting="OnGridSorting">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}" Width="105" />
            <DataGridTextColumn Header="Наименование" Binding="{Binding EquipmentName}" Width="*" />
            <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="140" />
            <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="140" />
            <DataGridTextColumn Header="Сер. №" Binding="{Binding SerialNumber}" Width="115" />
            <DataGridTextColumn Header="Цех" Binding="{Binding WorkshopName}" Width="150" />
            <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="135" />
            <DataGridTemplateColumn Header="Действия" Width="215">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="Карточка" Padding="7,4" FontSize="11" Click="OnDetailClick" Tag="{Binding EquipmentId}" />
                    <Button Content="Изм." Padding="7,4" FontSize="11" Click="OnEditClick" Tag="{Binding EquipmentId}" />
                    <Button Content="Удал." Padding="7,4" FontSize="11" Classes="danger" Click="OnDeleteClick" Tag="{Binding EquipmentId}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
        <TextBlock x:Name="PagingInfo" Text="Всего: 0" VerticalAlignment="Center" Foreground="#64748B" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
          <TextBlock Text="На странице:" VerticalAlignment="Center" />
          <ComboBox x:Name="PageSizeBox" Width="80" SelectedIndex="0" SelectionChanged="OnPageSizeChanged">
            <ComboBoxItem Content="25" />
            <ComboBoxItem Content="50" />
            <ComboBoxItem Content="100" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="PrevBtn" Content="← Назад" Classes="secondary" Click="OnPrevPage" />
          <TextBlock x:Name="PageLabel" Text="Стр. 1 / 1" VerticalAlignment="Center" FontWeight="SemiBold" />
          <Button x:Name="NextBtn" Content="Вперёд →" Classes="secondary" Click="OnNextPage" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border x:Name="FormModal" Background="#80000000" IsVisible="False">
      <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="card"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <ScrollViewer MaxHeight="620">
          <StackPanel Spacing="10">
            <TextBlock x:Name="FormTitle" Text="Новое оборудование" FontSize="18" FontWeight="Bold" />
            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                <TextBlock Text="Инвентарный номер *" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="FormInvBox" Watermark="EQ-025" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Серийный номер" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="FormSerialBox" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="Наименование *" FontSize="12" FontWeight="SemiBold" />
              <TextBox x:Name="FormNameBox" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                <TextBlock Text="Модель *" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="FormModelBox" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Производитель" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="FormManufacturerBox" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                <TextBlock Text="Цех *" FontSize="12" FontWeight="SemiBold" />
                <ComboBox x:Name="FormWorkshopBox" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Статус *" FontSize="12" FontWeight="SemiBold" />
                <ComboBox x:Name="FormStatusBox" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                <TextBlock Text="Ввод в эксплуатацию (ГГГГ-ММ-ДД)" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="FormCommDateBox" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Ввод в работу (ГГГГ-ММ-ДД)" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="FormOpDateBox" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="FormErrorText" Foreground="#DC2626" FontSize="12" IsVisible="False" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
              <Button Content="Отмена" Classes="secondary" Click="OnCloseFormModal" />
              <Button Content="Сохранить" Classes="primary" Click="OnSaveFormClick" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <Border x:Name="DetailModal" Background="#80000000" IsVisible="False">
      <Border Width="760" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="card"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="DetailTitle" Text="Карточка оборудования" FontSize="18" FontWeight="Bold" />
              <TextBlock x:Name="DetailSubtitle" FontSize="12" Foreground="#64748B" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ Создать заявку" Classes="primary" Click="OnCreateOrderForEq" />
          </Grid>
          <TabControl Grid.Row="1">
            <TabItem Header="Основная информация">
              <ScrollViewer Padding="8">
                <TextBlock x:Name="DetailInfoText" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
              </ScrollViewer>
            </TabItem>
            <TabItem Header="История заявок">
              <DataGrid x:Name="DetailOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="110" />
                  <DataGridTextColumn Header="Тип" Binding="{Binding OrderTypeRu}" Width="110" />
                  <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="130" />
                  <DataGridTextColumn Header="Простой (ч)" Binding="{Binding DowntimeHours}" Width="95" />
                  <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="История ТО">
              <Grid RowDefinitions="*,*" Margin="4">
                <DataGrid x:Name="DetailSchedulesGrid" Grid.Row="0" Margin="0,0,0,8" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="План. дата" Binding="{Binding PlannedDate}" Width="110" />
                    <DataGridTextColumn Header="Вид ТО" Binding="{Binding TypeName}" Width="*" />
                    <DataGridTextColumn Header="Бригада" Binding="{Binding TeamName}" Width="150" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusBadgeText}" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="DetailHistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding ChangedAt}" Width="160" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="140" />
                    <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
          </TabControl>
          <Button Grid.Row="2" Content="Закрыть" HorizontalAlignment="Right" Classes="secondary" Margin="0,10,0,0" Click="OnCloseDetailModal" />
        </Grid>
      </Border>
    </Border>

    <Border x:Name="DeleteConfirmModal" Background="#80000000" IsVisible="False">
      <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="card"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="12">
          <TextBlock Text="Подтверждение удаления" FontSize="17" FontWeight="Bold" />
          <TextBlock x:Name="DeleteConfirmText" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Отмена" Classes="secondary" Click="OnCancelDelete" />
            <Button Content="Удалить" Classes="danger" Click="OnConfirmDelete" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
